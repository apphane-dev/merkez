---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card" id={project.id} data-reveal>
  <header class="card-head">
    <h3 class="card-name">
      <span class="brace" aria-hidden="true">&#123;</span>
      {project.name}
      <span class="brace" aria-hidden="true">&#125;</span>
    </h3>
    <p class="gloss">
      <span lang="tr">{project.turkish.word}</span> — Turkish for <em>{project.turkish.meaning}</em>
    </p>
  </header>

  <p class="tagline">{project.tagline}</p>
  <p class="desc">{project.description}</p>

  <ul class="features">
    {project.features.map((feature) => <li>{feature}</li>)}
  </ul>

  {
    project.install && (
      <p class="install">
        <span class="install-label">{project.install.label}</span>
        <code>{project.install.command}</code>
      </p>
    )
  }

  <footer class="card-foot">
    {project.license && <span class="meta">{project.license}</span>}
    <span class="meta">{project.language}</span>
    <span class="meta">{project.platform}</span>
    <span class="spacer" aria-hidden="true"></span>
    {
      project.home && (
        <a class="link home-link" href={project.home}>
          Visit {project.name} ↗
        </a>
      )
    }
    {
      project.links.map((link) => (
        <a class="link" href={link.href}>
          {link.label} ↗
        </a>
      ))
    }
  </footer>
</article>

<style>
  .card {
    background: var(--surface-1);
    border: 1px solid var(--cream-faint);
    border-radius: 16px;
    padding: 24px;
    scroll-margin-top: 96px;
    transition: border-color var(--dur) var(--ease-fluid);
  }

  .card:hover {
    border-color: rgba(253, 161, 21, 0.4);
  }

  .card-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }

  .card-name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 24px; /* text-2xl */
    line-height: 32px;
  }

  .brace {
    color: var(--amber);
    font-weight: 600;
  }

  .gloss {
    font-size: 14px; /* text-sm */
    line-height: 20px;
    color: var(--cream-dim);
  }

  .tagline {
    margin-top: 12px;
    font-size: 18px; /* text-lg */
    line-height: 28px;
    font-weight: 500;
  }

  .desc {
    margin-top: 8px;
    color: var(--cream-dim);
    font-size: 16px; /* text-base */
    line-height: 24px;
    max-width: var(--measure-text);
  }

  .features {
    margin-top: 16px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .features li {
    font-family: var(--font-mono);
    font-size: 12px; /* text-xs */
    line-height: 16px;
    color: var(--cream);
    border: 1px solid var(--cream-faint);
    border-radius: 999px;
    padding: 4px 12px;
  }

  .install {
    margin-top: 24px;
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }

  .install-label {
    font-size: 14px; /* text-sm */
    line-height: 20px;
    color: var(--cream-dim);
  }

  .install code {
    background: var(--surface-2);
    border: 1px solid var(--cream-faint);
    border-radius: 8px;
    padding: 8px 12px;
    color: var(--amber);
  }

  .card-foot {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--cream-faint);
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 12px; /* text-xs */
    line-height: 16px;
    color: var(--cream-dim);
  }

  .spacer {
    flex: 1;
  }

  .link {
    font-weight: 600;
    font-size: 14px; /* text-sm */
    line-height: 20px;
  }

  @media (max-width: 40rem) {
    .card {
      padding: 24px 16px;
    }
  }
</style>
