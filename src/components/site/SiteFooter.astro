---
const year = new Date().getFullYear();
---

<footer class="bottom">
  <span>© {year} apphane</span>
  <nav class="foot-nav" aria-label="Footer">
    <a href="/writing/">Writing</a>
    <a href="/recommendations/">Recommendations</a>
    <a href="/sponsors/">Sponsors</a>
    <a href="/rss.xml">RSS</a>
    <a href="https://github.com/apphane-dev">GitHub</a>
  </nav>
</footer>

<style>
  .bottom {
    max-width: var(--page);
    margin: 0 auto;
    padding: 32px 24px 40px;
    border-top: 1px solid var(--cream-faint);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 48px;
    flex-wrap: wrap;
    font-size: 14px; /* text-sm */
    line-height: 20px;
    color: var(--cream-dim);
  }

  .foot-nav {
    display: flex;
    gap: 4px 24px;
    flex-wrap: wrap;
  }

  .foot-nav a {
    color: var(--cream-dim);
  }

  .foot-nav a:hover {
    color: var(--amber);
  }
</style>
