---
/**
 * Fluid island nav. A floating glass pill detached from the top; on small
 * screens the hamburger morphs into an X and the menu opens as a screen
 * filling overlay with staggered link reveals. All motion runs on the shared
 * fluid cubic bezier.
 */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const links = [
  { label: 'Projects', href: '/#residents', match: /^\/$/ },
  { label: 'Writing', href: '/writing/', match: /^\/writing/ },
  { label: 'Recommendations', href: '/recommendations/', match: /^\/recommendations/ },
  { label: 'Sponsors', href: '/sponsors/', match: /^\/sponsors/ },
];
const stagger = [100, 150, 200, 250, 300];
---

<header class="top">
  <div class="pill">
    <a class="home" href="/" aria-label="apphane home">
      <svg width="22" height="22" viewBox="0 0 64 64" aria-hidden="true">
        <g fill="var(--amber)">
          <rect x="8" y="8" width="21" height="21" rx="8"></rect>
          <rect x="35" y="8" width="21" height="21" rx="8"></rect>
          <rect x="8" y="35" width="21" height="21" rx="8"></rect>
        </g>
        <rect x="35" y="35" width="21" height="21" rx="8" fill="var(--cream)"></rect>
      </svg>
      <span>apphane</span>
    </a>
    <nav class="links" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.match.test(path) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a class="ext" href="https://github.com/apphane-dev">GitHub ↗</a>
    </nav>
    <button class="burger" type="button" aria-expanded="false" aria-controls="menu-overlay" aria-label="Open menu">
      <span class="line" aria-hidden="true"></span>
      <span class="line" aria-hidden="true"></span>
    </button>
  </div>

  <div class="menu" id="menu-overlay">
    <nav aria-label="Menu">
      {
        links.map((link, i) => (
          <a
            class="menu-link"
            href={link.href}
            aria-current={link.match.test(path) ? 'page' : undefined}
            style={`transition-delay: ${stagger[i] ?? 350}ms`}
          >
            {link.label}
          </a>
        ))
      }
      <a class="menu-link ext" href="https://github.com/apphane-dev" style="transition-delay: 350ms">
        GitHub ↗
      </a>
    </nav>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    padding: 24px 24px 0;
    pointer-events: none;
  }

  .pill {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid var(--cream-faint);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: background-color var(--dur) var(--ease-fluid);
  }

  .home {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: var(--cream);
    padding: 0 4px;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .links a {
    font-weight: 600;
    font-size: 14px;
    line-height: 20px;
    color: var(--cream);
    padding: 8px 12px;
    border-radius: 999px;
    transition:
      color var(--dur) var(--ease-fluid),
      background-color var(--dur) var(--ease-fluid),
      transform var(--dur) var(--ease-fluid);
  }

  .links a:hover {
    color: var(--amber);
    background: rgba(253, 161, 21, 0.1);
  }

  .links a:active {
    transform: scale(0.98);
  }

  .links a[aria-current='page'] {
    color: var(--amber);
  }

  .ext {
    color: var(--cream-dim);
  }

  /* Hamburger: two lines that rotate and translate into a perfect X. */
  .burger {
    display: none;
    position: relative;
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .burger .line {
    position: absolute;
    left: 10px;
    width: 20px;
    height: 2px;
    background: var(--cream);
    border-radius: 999px;
    transition:
      transform var(--dur) var(--ease-fluid),
      top var(--dur) var(--ease-fluid);
  }

  .burger .line:nth-child(1) {
    top: 17px;
  }

  .burger .line:nth-child(2) {
    top: 23px;
  }

  .burger[aria-expanded='true'] .line:nth-child(1) {
    top: 20px;
    transform: rotate(45deg);
  }

  .burger[aria-expanded='true'] .line:nth-child(2) {
    top: 20px;
    transform: rotate(-45deg);
  }

  /* Screen filling glass overlay with staggered link reveals. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(64px);
    -webkit-backdrop-filter: blur(64px);
    opacity: 0;
    visibility: hidden;
    pointer-events: auto;
    transition:
      opacity var(--dur) var(--ease-fluid),
      visibility var(--dur) var(--ease-fluid);
  }

  .menu.open {
    opacity: 1;
    visibility: visible;
  }

  .menu nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }

  .menu-link {
    font-size: 30px; /* text-3xl */
    line-height: 36px;
    font-weight: 600;
    color: var(--cream);
    opacity: 0;
    translate: 0 48px;
    transition:
      opacity var(--dur) var(--ease-fluid),
      translate var(--dur) var(--ease-fluid),
      color var(--dur) var(--ease-fluid);
  }

  .menu.open .menu-link {
    opacity: 1;
    translate: 0 0;
  }

  .menu-link[aria-current='page'] {
    color: var(--amber);
  }

  .menu-link.ext {
    color: var(--cream-dim);
  }

  @media (max-width: 48rem) {
    .links {
      display: none;
    }
    .burger {
      display: block;
    }
    .menu {
      display: flex;
    }
  }
</style>

<script>
  const burger = document.querySelector('.burger');
  const menu = document.getElementById('menu-overlay');
  if (burger && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open ? 'hidden' : '';
    };
    burger.addEventListener('click', () => setOpen(!menu.classList.contains('open')));
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
