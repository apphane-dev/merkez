---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import WindowStrip from '../components/WindowStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

/**
 * B11 tagline reveal copy. Two lines at text-5xl inside the 680px hero cap;
 * each word activates individually, in reading order, as the section scrolls
 * into view.
 */
const TAGLINE = 'Small tools, built in the open, each doing one thing well.';
const taglineWords = TAGLINE.split(' ');
---

<Base
  title="apphane — a house for small, sharp tools"
  description="apphane, from the Turkish suffix hane meaning “house of”, is the home of our apps, tools, and ideas. Open source by default, each named in Turkish, each built to do one thing well."
>
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader />

  <main id="main">
    <!-- Hero: headline, subheadline, primary CTA, proof, visual. -->
    <section class="hero">
      <img
        class="mark"
        src="/apphane-logo.png"
        alt="apphane — a house drawn with curly braces, windows lit amber. Apps, tools, ideas."
        width="96"
        height="96"
        fetchpriority="high"
      />
      <h1>A house for<br />small, sharp tools.</h1>
      <p class="sub">
        <strong>apphane</strong>, from the Turkish suffix <span lang="tr">hane</span> meaning
        “house of”, is where our apps, tools, and ideas live. Each project is named in Turkish,
        open source by default, and built to do one thing well.
      </p>
      <div class="cta-row">
        <a class="btn btn-solid" href="#residents">See the projects</a>
      </div>
      <p class="proof">
        Open source by default. Nehir ships under GPL 2.0, Kahraman under MIT, with every
        dependency credited file by file.
      </p>
      <div class="strip-wrap">
        <WindowStrip />
      </div>
    </section>

    <!-- B11 tagline reveal: its own moment, mid page. -->
    <section class="tagline-section" aria-label="What apphane stands for">
      <p class="tagline" data-tagline>
        {
          taglineWords.map((word, i) => (
            <span class="word" style={`transition-delay: ${i * 80}ms`}>
              {word}
            </span>
          ))
        }
      </p>
    </section>

    <section class="residents" id="residents" aria-labelledby="residents-heading">
      <h2 class="eyebrow" id="residents-heading">
        In the house<span class="tr" lang="tr" aria-hidden="true">hane</span>
      </h2>
      <div class="cards">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="ethos" aria-labelledby="ethos-heading" data-reveal>
      <h2 class="eyebrow" id="ethos-heading">
        House rules<span class="tr" lang="tr" aria-hidden="true">kurallar</span>
      </h2>
      <div class="rules">
        <div class="rule">
          <h3>Open source by default</h3>
          <p>
            The code lives in the open, under real licenses. Nehir ships as GPL 2.0 and Kahraman
            as MIT.
          </p>
        </div>
        <div class="rule">
          <h3>Lineage stays visible</h3>
          <p>
            Tools built on other people's work say so, file by file. Nehir credits its OmniWM
            foundation in a <a href="https://github.com/apphane-dev/nehir/blob/main/NOTICE.md"
              >NOTICE</a
            > that tracks the provenance of every source file.
          </p>
        </div>
        <div class="rule">
          <h3>One thing, done well</h3>
          <p>
            Each project keeps a deliberately narrow scope. Nehir is one layout model, scrolling
            columns, not a window manager for every taste.
          </p>
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-heading" data-reveal>
      <h2 id="closing-heading">Pull up a chair.</h2>
      <p>
        Take a tool, read the code, or open an issue and help furnish a room. The whole house is
        on GitHub.
      </p>
      <a class="btn btn-solid" href="https://github.com/apphane-dev">Explore apphane on GitHub</a>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  main {
    max-width: var(--page);
    margin: 0 auto;
    padding: 0 24px 64px;
  }

  /* ---- hero ---- */

  .hero {
    text-align: center;
    padding: 24px 0 80px;
  }

  .mark {
    width: 96px;
    height: 96px;
    margin: 0 auto;
  }

  h1 {
    /* B5: the one permitted gradient, on the heading text only. */
    background: linear-gradient(90deg, #ffffff 0%, #9b9b9b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    max-width: 680px;
    margin: 24px auto 0;
    font-weight: 700;
    font-size: 48px; /* text-5xl */
    line-height: 1;
  }

  .sub {
    max-width: 680px;
    margin: 24px auto 0;
    font-size: 18px; /* text-lg */
    line-height: 28px;
    color: var(--cream-dim);
  }

  .sub strong {
    color: var(--cream);
  }

  .cta-row {
    margin-top: 32px;
  }

  .proof {
    margin-top: 16px;
    font-size: 14px; /* text-sm */
    line-height: 20px;
    color: var(--cream-dim);
  }

  .strip-wrap {
    margin-top: 48px;
  }

  /* ---- B11 tagline reveal ---- */

  .tagline-section {
    padding: 80px 0;
    text-align: center;
  }

  .tagline {
    max-width: 680px;
    margin: 0 auto;
    font-weight: 700;
    font-size: 48px; /* text-5xl */
    line-height: 1;
  }

  .tagline .word {
    display: inline-block;
    color: var(--cream);
    transition: color var(--dur) var(--ease-fluid);
  }

  :global(html.js) .tagline:not(.is-visible) .word {
    color: rgba(252, 237, 210, 0.3);
  }

  .tagline .word + .word {
    margin-left: 0.24em;
  }

  .tagline.is-visible .word {
    color: var(--cream);
  }

  /* ---- residents ---- */

  .residents {
    scroll-margin-top: 96px;
    padding: 32px 0;
    display: grid;
    gap: 24px;
  }

  .cards {
    display: grid;
    gap: 24px;
  }

  /* ---- ethos ---- */

  .ethos {
    padding: 64px 0 32px;
  }

  .rules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 32px;
  }

  .rule h3 {
    font-weight: 700;
    font-size: 18px; /* text-lg */
    line-height: 28px;
    margin-bottom: 8px;
  }

  .rule p {
    color: var(--cream-dim);
    font-size: 14px; /* text-sm */
    line-height: 20px;
  }

  /* ---- closing CTA ---- */

  .closing {
    text-align: center;
    padding: 80px 0 32px;
  }

  .closing h2 {
    font-weight: 700;
    font-size: 36px; /* text-4xl */
    line-height: 40px;
  }

  .closing p {
    max-width: 680px;
    margin: 16px auto 32px;
    color: var(--cream-dim);
    font-size: 18px; /* text-lg */
    line-height: 28px;
  }

  @media (max-width: 40rem) {
    h1 {
      font-size: 36px; /* text-4xl */
      line-height: 40px;
    }
    .tagline {
      font-size: 36px; /* text-4xl */
      line-height: 40px;
    }
    .hero {
      padding-top: 16px;
    }
  }
</style>

<script>
  // B11 tagline reveal: one IntersectionObserver on the section; the words
  // then light up one at a time in reading order via per word transition
  // delays on the shared fluid curve.
  const tagline = document.querySelector('[data-tagline]');
  if (tagline) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) {
      tagline.classList.add('is-visible');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.5 },
      );
      io.observe(tagline);
    }
  }
</script>
