---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { getSponsors, showSeedNote, sponsorLink } from '../data/sponsors';

const visibleSponsors = await getSponsors();

/** "justinmiller.io" from a URL, for the mono caption under a name. */
const hostOf = (url: string) => new URL(url).host.replace(/^www\./, '');

const funds = [
  'Time — the scarce input. Sponsorship buys hours to maintain and document, not just to build.',
  'Infrastructure — domains, CI minutes, and the small recurring costs of keeping things online.',
  'Accessibility and testing work — the unglamorous parts that make a tool trustworthy.',
];
---

<Base
  title="Sponsors — apphane"
  description="Why sponsor the apphane house, where the support goes, and how to help. Support keeps the lights on; it never buys editorial control."
>
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader />
  <main id="main" class="page">
    <div class="page-head">
      <p class="eyebrow">Sponsors<span class="tr" lang="tr" aria-hidden="true">destek</span></p>
      <h1>Keep a light on.</h1>
      <p class="lede">
        Everything here is open source and free to use. Sponsorship is how people who get value
        from the house help keep it maintained — and keep the next room getting built.
      </p>
      <p class="cta-row">
        <a class="cta" href={sponsorLink}>Sponsor on GitHub ↗</a>
        <span class="cta-note">Support Aleksei Gurianov’s work on apphane.</span>
      </p>
    </div>

    <section class="block" aria-labelledby="funds-head">
      <h2 class="eyebrow" id="funds-head">What it funds<span class="tr" lang="tr" aria-hidden="true">bütçe</span></h2>
      <ul class="funds">
        {funds.map((f) => <li>{f}</li>)}
      </ul>
    </section>

<section class="block" aria-labelledby="wall-head">
      <h2 class="eyebrow" id="wall-head">On the wall<span class="tr" lang="tr" aria-hidden="true">duvar</span></h2>
      {showSeedNote && (
        <p class="seed-note">
          <strong>Seed placeholder.</strong> The sponsor below is an example showing how names
          appear. Real supporters replace it.
        </p>
      )}
      {visibleSponsors.length > 0 ? (
        <ul class="wall">
          {visibleSponsors.map((s, i) => (
            <li class="sponsor-card" style={`--delay: ${i * 90}ms`}>
              <a class="card-link" href={s.url}>
                {s.avatar ? (
                  <img
                    class="avatar"
                    src={s.avatar}
                    alt=""
                    width="112"
                    height="112"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="avatar placeholder" aria-hidden="true">
                    <span class="panes"><i /><i /><i /><i /></span>
                  </span>
                )}
                <span class="sponsor-name">{s.name}</span>
                <span class="sponsor-site">{hostOf(s.url)}</span>
              </a>
              {s.blurb && <p class="sponsor-blurb">{s.blurb}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="wall-empty">
          No names on the wall yet. Be the first to keep a light on — your thanks appears here.
        </p>
      )}
    </section>

    <section class="block independence" aria-labelledby="indep-head">
      <h2 class="eyebrow" id="indep-head">Editorial independence<span class="tr" lang="tr" aria-hidden="true">bağımsızlık</span></h2>
      <p>
        Sponsorship funds the work; it does not buy the words. Support never implies an
        endorsement, and it never shapes what we write or recommend. When a sponsor also appears
        on the <a href="/recommendations/">recommendations</a> page, that relationship is disclosed
        in both places. Names and logos are shown only with permission, and removed on request.
      </p>
      <p class="contact">
        For in-kind or non-standard support, open an issue on
        <a href="https://github.com/apphane-dev">GitHub</a>.
      </p>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .cta-row {
    margin-top: 1.6rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta {
    display: inline-block;
    background: var(--amber);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    padding: 0.6rem 1.3rem;
    border-radius: 0.7rem;
    box-shadow: 0 0 26px var(--glow);
  }
  .cta:hover {
    background: var(--ember);
    color: var(--ink);
  }

  .cta-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--cream-dim);
  }

  .block {
    padding: 2.6rem 0;
    border-top: 1px solid var(--cream-faint);
  }

  /* Roomy columns at desktop so each reason wraps in full phrases instead of
     stranding one or two words per line in a skinny centered strip. Collapses
     to a single column once a cell can no longer hold a comfortable measure. */
  .funds {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: 1.2rem 2.6rem;
  }
  .funds li {
    padding-left: 1.3rem;
    position: relative;
    color: var(--cream-dim);
  }
  .funds li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5em;
    height: 0.5em;
    border-radius: 0.14em;
    background: var(--amber);
  }

  /* Each sponsor is a lit window: avatar in an amber frame, the light they
     keep on. Cards settle in staggered like the house windows up top. */
  .wall {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.2rem;
    max-width: 46rem;
  }

  .sponsor-card {
    animation: settle 0.5s ease-out both;
    animation-delay: var(--delay);
  }

  .card-link {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.35rem;
    padding: 1.7rem 1.2rem 1.4rem;
    border: 1px solid var(--cream-faint);
    border-radius: 0.9rem;
    background: var(--ink-raised);
  }
  .card-link:hover {
    border-color: var(--amber);
  }

  .avatar {
    width: 5.5rem;
    height: 5.5rem;
    margin-bottom: 0.8rem;
    border-radius: 0.8rem;
    border: 1.5px solid var(--amber);
    box-shadow: 0 0 22px var(--glow);
    object-fit: cover;
  }
  .card-link:hover .avatar {
    box-shadow: 0 0 34px var(--glow);
  }

  /* No avatar (manual entries): the dark window panes stand in. */
  .avatar.placeholder {
    display: grid;
    place-items: center;
    background: rgba(252, 237, 210, 0.04);
  }
  .avatar.placeholder .panes {
    display: grid;
    grid-template-columns: repeat(2, 1.1rem);
    grid-template-rows: repeat(2, 1.1rem);
    gap: 0.35rem;
  }
  .avatar.placeholder .panes i {
    border-radius: 0.2rem;
    background: var(--amber);
  }

  .sponsor-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--cream);
  }
  .card-link:hover .sponsor-name {
    color: var(--amber);
  }

  .sponsor-site {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--cream-dim);
  }

  .sponsor-blurb {
    margin: 0.7rem 0 0;
    color: var(--cream-dim);
    font-size: 0.9rem;
  }

  @keyframes settle {
    from {
      opacity: 0;
      translate: 0 6px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .wall-empty {
    color: var(--cream-dim);
    font-style: italic;
  }

  .independence p {
    max-width: var(--measure);
    color: var(--cream-dim);
  }
  .independence .contact {
    margin-top: 1rem;
  }
</style>
