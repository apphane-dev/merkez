---
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';
import { markdownPath } from '../lib/markdown-alternate';

interface Props {
  title: string;
  description: string;
  /** 'article' switches Open Graph and enables the dates below. */
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /** Advertise a Markdown alternate, built from this page's <main>. */
  markdown?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  publishedAt,
  updatedAt,
  markdown = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('apphane-logo.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {markdown && (
      <link rel="alternate" type="text/markdown" href={markdownPath(Astro.url.pathname)} />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="apphane — writing"
      href={new URL('rss.xml', Astro.site)}
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    {updatedAt && (
      <meta property="article:modified_time" content={updatedAt.toISOString()} />
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#131209" />
  </head>
  <body>
    <slot />
    <script>
      // Scroll interpolation engine. Elements marked [data-reveal] fade up
      // heavily as they enter the viewport; observed once, never a scroll
      // listener. No-JS visitors see the page statically.
      document.documentElement.classList.add('js');
      const targets = document.querySelectorAll('[data-reveal]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
